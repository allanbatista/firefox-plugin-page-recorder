{
  "manifest_version": 2,
  "name": "Firefox Page Recorder",
  "version": "0.1.0",
  "description": "Record the visible area of the active tab with optional microphone and system audio, a 3-second countdown, saved FPS, and WebM export.",
  "homepage_url": "https://github.com/allanbatista/firefox-page-recorder",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-page-recorder@example.com"
    }
  },
  "web_accessible_resources": [
    "popup.html",
    "popup.css",
    "popup.js"
  ],
  "permissions": [
    "tabs",
    "downloads",
    "storage",
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "Firefox Page Recorder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-page-recorder.svg",
      "32": "assets/icons/icon-page-recorder.svg",
      "48": "assets/icons/icon-page-recorder.svg"
    }
  }
}
